<Window x:Class="no_odp_databinding.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:no_odp_databinding"
        mc:Ignorable="d"
        DataContext="{Binding RelativeSource={RelativeSource Self}}"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel>
            <ListBox
                ItemsSource="{Binding AvailableNumbers}"
                Margin="4 0 1 10"
                Height="250" />
            <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 0 20 10">
                <Button x:Name="BtnAdd" Width="75" Margin="10 0 0 0" Click="BtnAdd_Click" >Add</Button>
                <Button x:Name="BtnDel" Width="75" Margin="10 0 0 0" Click="BtnDel_Click" >Delete</Button>
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
