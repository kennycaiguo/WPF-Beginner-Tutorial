<UserControl x:Class="windowstoreclone.UserControls.ProductivityTopApps"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:windowstoreclone.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="0.33*" />
            <RowDefinition Height="0.33*"  />
            <RowDefinition Height="0.33*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.25*" x:Name="LeftMostColumn"  />
            <ColumnDefinition Width="0.25*" x:Name="LeftColumn" />
            <ColumnDefinition Width="0.25*" x:Name="RightColumn" />
            <ColumnDefinition Width="0.25*" x:Name="RightMostColumn"/>
        </Grid.ColumnDefinitions>
        <Image Grid.Row="0" Grid.Column="0" Grid.RowSpan="2" Grid.ColumnSpan="2" Source="/Images/ProductivityAppIcons/86-railway.png"
               HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Stretch="Fill" Margin="2" MouseUp="Image_MouseUp" />
        <Image x:Name="RightLargeImage" Grid.Row="0" Grid.Column="2" Grid.RowSpan="2" Grid.ColumnSpan="2" 
               Source="/Images/ProductivityAppIcons/87-Stock market.png"
               HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Stretch="Fill" Margin="2" MouseUp="Image_MouseUp" />
        <Image Grid.Row="2" Grid.Column="0" Source="/Images/ProductivityAppIcons/88-beans.png"
               HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Stretch="Fill" Margin="2" MouseUp="Image_MouseUp" />
        <Image Grid.Row="2" Grid.Column="1"  Source="/Images/ProductivityAppIcons/89-Accessories.png"
               HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Stretch="Fill" Margin="2" MouseUp="Image_MouseUp" />
        <Image Grid.Row="2" Grid.Column="2"  Source="/Images/ProductivityAppIcons/90-ipad mini.png"
               HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Stretch="Fill" Margin="2" MouseUp="Image_MouseUp" />
        <Image Grid.Row="2" Grid.Column="3"  Source="/Images/ProductivityAppIcons/91-smartphone.png"
               HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Stretch="Fill" Margin="2" MouseUp="Image_MouseUp" />
    </Grid>
</UserControl>
