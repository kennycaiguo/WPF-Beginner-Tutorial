<UserControl x:Class="windowstoreclone.UserControls.TopApps"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:windowstoreclone.UserControls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <!--4列-->
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="0.25*" />
            <ColumnDefinition Width="0.25*" />
            <ColumnDefinition Width="0.25*" />
            <ColumnDefinition Width="0.25*" />
        </Grid.ColumnDefinitions>
        <!--3行-->
        <Grid.RowDefinitions>
            <RowDefinition Height="0.33*" />
            <RowDefinition Height="0.33*" />
            <RowDefinition Height="0.33*" />
        </Grid.RowDefinitions>
        <Image Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Grid.RowSpan="2" VerticalAlignment="Stretch" 
             HorizontalAlignment="Stretch"  Stretch="Fill" Source="/Images/TopAppIcons/81-tropical.png" 
             Margin="2" MouseUp="Image_MouseUp" />
        
        <Image x:Name="TopImage" Grid.Row="0" Grid.Column="3" Source="/Images/TopAppIcons/82-circus fun.png" 
               VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="2" Stretch="Fill"
               MouseUp="Image_MouseUp" />
        
        <Image x:Name="MeddleImage" Grid.Row="1" Grid.Column="3" Source="/Images/TopAppIcons/83-race extreme.png" 
               VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="2" Stretch="Fill"
               MouseUp="Image_MouseUp" />
        
        <Image x:Name="BottomImage" Grid.Row="2" Grid.Column="3" Source="/Images/TopAppIcons/84-chat message.png" 
               VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="2" Stretch="Fill"
               MouseUp="Image_MouseUp" />

        <Grid x:Name="BottomGrid" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="0.5*" />
                <RowDefinition Height="0.5*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.5*" />
                <ColumnDefinition Width="0.5*" />
            </Grid.ColumnDefinitions>
            <Button x:Name="TopAppsButton" FontSize="18" Margin="2" Grid.Row="0" Grid.Column="0">TopApps</Button>
            <Button x:Name="TopGamesButton" FontSize="18" Margin="2" Grid.Row="1" Grid.Column="0">TopGames</Button>
            <Button x:Name="FeaturedButton" FontSize="18" Margin="2" Grid.Row="0" Grid.Column="1">Featured</Button>
            <Button x:Name="CollectionsButton" FontSize="18" Margin="2" Grid.Row="1" Grid.Column="1">Collections</Button>
        </Grid>

        <Image  Grid.Row="2" Grid.Column="2" Source="/Images/TopAppIcons/85-Night Castle.png" 
           VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Margin="2" Stretch="Fill"
           MouseUp="Image_MouseUp" />
    </Grid>
</UserControl>
