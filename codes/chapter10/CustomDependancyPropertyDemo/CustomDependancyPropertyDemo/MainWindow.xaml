<Window x:Class="CustomDependancyPropertyDemo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CustomDependancyPropertyDemo"
        xmlns:uc="clr-namespace:CustomDependancyPropertyDemo.UserControls"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    
    <StackPanel>
        <Button x:Name="mybtn" Content="Awesome UP" Click="mybtn_Click" Margin="5" Width="120"/>
        <uc:MyUC x:Name="MainCtrl" Awesomeness="1000">
            <uc:MyUC.Style>
                <Style TargetType="uc:MyUC">
                    <Style.Triggers>
                        <Trigger Property="Awesomeness" Value="2000" >
                            <Setter Property="Background" Value="DeepSkyBlue" />
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </uc:MyUC.Style>
           
        </uc:MyUC>
        <Label x:Name="AwesomenessLbl" Content="{Binding ElementName=MainCtrl,Path=Awesomeness}" 
               HorizontalAlignment="Center" FontSize="30"></Label>
    </StackPanel>
</Window>
