<UserControl x:Class="InstaUserControlDemo.PostControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:InstaUserControlDemo"
             mc:Ignorable="d" 
             d:DesignHeight="60" d:DesignWidth="550">
    <Grid>
        <StackPanel Orientation="Horizontal">
            <Image x:Name="Heart" Source="/icons/nolikesm.png" Margin="8" Stretch="Uniform" MouseDown="Heart_MouseDown"/>
            <Image x:Name="Comment" Source="/icons/commentsm.png" Margin="8" Stretch="Uniform" />
            <Image x:Name="Send" Source="/icons/sendsm.png" Margin="8" Stretch="Uniform" />
        </StackPanel>
        <Image Name="BookMark" Source="/icons/bookmarks..png" Margin="8" Stretch="Uniform" HorizontalAlignment="Right"/>
    </Grid>
</UserControl>
