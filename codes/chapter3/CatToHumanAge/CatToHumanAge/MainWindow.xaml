<Window x:Class="CatToHumanAge.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:CatToHumanAge"
        mc:Ignorable="d"
        Title="MainWindow" Height="120" Width="300">
    <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="10 10 0 0">
            <TextBlock Text="Input Cat Age(years):" />
            <TextBox x:Name="tbAgeInp" Width="120" Margin="5 0 0 0" 
                     TextAlignment="Center" FontSize="16"
                     KeyDown="tbAgeInp_KeyDown"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="10 10 0 0">
            <TextBlock Text="To humen age result:" />
            <TextBox x:Name="tbAgeOpt" Width="120" Margin="5 0 0 0" 
                     TextAlignment="Center" FontSize="16"
                     />
        </StackPanel>
    </StackPanel>
</Window>
