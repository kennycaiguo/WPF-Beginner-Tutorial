<Window x:Class="csharp_animatin_demo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:csharp_animatin_demo"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <StackPanel>
        <Grid x:Name="AniGrid" Loaded="AniGrid_Loaded" MouseEnter="AniGrid_MouseEnter" MouseLeave="AniGrid_MouseLeave">
            <Label FontSize="40" Content="Animation Label" />
        </Grid>
        <TextBlock Text="NO Animation Text"  FontSize="30"/>
    </StackPanel>
</Window>
