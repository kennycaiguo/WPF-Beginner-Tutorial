<Page x:Class="pagenavdemo.Pages.Page2"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:pagenavdemo.Pages"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="Page2">

    <StackPanel>
        <Label Content="This is Page2" FontSize="20" FontWeight="Bold" />
        <StackPanel Orientation="Horizontal">
            <Button x:Name="toPage1" Click="toPage1_Click" Content="Go to Page1" />
            <Button x:Name="toPage3" Click="toPage3_Click" Content="Go to Page3" />
        </StackPanel>
    </StackPanel>
</Page>
